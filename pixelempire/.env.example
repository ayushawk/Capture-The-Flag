# ---- Core ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pixelempire?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PixelEmpire"

# 32+ random bytes. Signs session cookies, magic-link tokens and CSRF tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# ---- Razorpay (hosted checkout) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Email (magic link) ----
# Leave EMAIL_PROVIDER=console in development: links are printed to the server log.
EMAIL_PROVIDER="console"
EMAIL_FROM="PixelEmpire <login@pixelempire.example>"
RESEND_API_KEY=""

# ---- Ops ----
# Shared secret required by POST /api/cron/expire-locks (also accepts Vercel Cron auth).
CRON_SECRET=""
LOG_LEVEL="info"

# ---- Feature flags (V2 mechanics; keep false in V1) ----
BATTLES_ENABLED=false
EXPANSION_ENABLED=false
POWER_SCORE_ENABLED=false
EMPIRE_LEVELS_ENABLED=false
PREMIUM_LAND_ENABLED=false
SPONSORED_LAND_ENABLED=false
